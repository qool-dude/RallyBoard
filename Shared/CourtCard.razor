@implements IDisposable
@inject CourtAllocationService Allocation

<div class="court @(Court.IsFull ? "court--full" : "")">
    <div class="court__head">
        <h3>@Court.Name</h3>
        <span class="court__count">@Court.FilledCount/4</span>
        <div class="court__actions">
            @if (Court.FilledCount < 2)
            {
                <form class="waiting__add" @onsubmit="PickGame" @onsubmit:preventDefault>
                    <button type="submit" class="btn btn-primary btn-sm">Pick Game</button>
                </form>
            }
            else
            {
                <button class="icon-btn @(Court.IsRunning ? "icon-btn--active" : "")" title="@(Court.IsRunning ? "Pause timer" : "Start timer")" @onclick="ToggleTimer">
                    @(Court.IsRunning ? "⏸" : "▶")
                </button>
                <span class="court__timer">@Elapsed</span>
                @if (Court.IsRunning)
                {
                  <button class="icon-btn" title="End game" disabled="@(Court.FilledCount < 2)" @onclick="OpenEndGame">✓</button>
                }
                <button class="icon-btn" title="Clear court" @onclick="ClearCourt">&#8635;</button>
            }
        </div>
    </div>

    <div class="court__field">
        <div class="court__team">
            <CourtSlot Court="Court" Index="0" Player="Court.Slots[0]" />
            <CourtSlot Court="Court" Index="1" Player="Court.Slots[1]" />
        </div>
        <div class="court__net" aria-hidden="true"></div>
        <div class="court__team">
            <CourtSlot Court="Court" Index="2" Player="Court.Slots[2]" />
            <CourtSlot Court="Court" Index="3" Player="Court.Slots[3]" />
        </div>
    </div>
</div>

<EndGameModal @ref="popup" Court="Court"
              Visible="_showEndGame"
              PreviewSlots="_pendingPick?.Slots"
              OnClose="CloseModal"
              OnConfirm="HandleEndGame"
              OnWaitforPlayers="HandleWaitforPlayers"
              OnAccept="HandleAccept"/>

@code {
    [Parameter, EditorRequired] public Court Court { get; set; } = null!;

    private System.Threading.Timer? _timer;
    private bool _showEndGame;
    private MatchmakingPickResult? _pendingPick;
    EndGameModal popup = null!;

    private string Elapsed =>
        FormatElapsed(Court.GetElapsedTime());

    private static string FormatElapsed(TimeSpan ts)
    {
        if (ts.TotalHours >= 1)
            return string.Format("{0:%h}h {0:%m}m", ts);
        if (ts.TotalMinutes >= 1)
            return string.Format("{0:%m}m {0:ss}s", ts);
        return string.Format("{0:ss}s", ts);
    }

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer(_ =>
        {
            if (Court.IsRunning)
                InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);
    }

    private void PickGame()
    {
        var pick = Allocation.ProposePickGame();
        if (pick is null)
            return;

        _pendingPick = pick;
        OpenNextGame();
    }

    private void OpenEndGame()
    {
        _pendingPick = null;
        _showEndGame = true;
        popup.ResetForm();
    }

    private void OpenNextGame()
    {
        popup.ResetForm();
        popup.SetEnded();
        _showEndGame = true;
    }

    private void ToggleTimer() => Allocation.ToggleTimer(Court);

    private void ClearCourt() => Allocation.ClearCourt(Court);

    private void CloseModal()
    {
        // Cancel: discard draft, leave court/waiting unchanged
        _pendingPick = null;
        _showEndGame = false;
    }

    private void HandleEndGame(EndGameResult result)
    {
        Allocation.EndGame(Court, result.Winner, result.TeamAScore, result.TeamBScore);
        _pendingPick = Allocation.ProposePickGame();
        OpenNextGame();
    }

    private void HandleWaitforPlayers()
    {
        // Discard draft; court already cleared if coming from EndGame
        _pendingPick = null;
        if (Court.FilledCount > 0)
            Allocation.ClearCourt(Court);
        _showEndGame = false;
    }

    private void HandleAccept()
    {
        if (_pendingPick is not null)
            Allocation.ApplyPickGame(Court, _pendingPick, startTimer: true);
        else if (Court.FilledCount >= 2 && !Court.IsRunning)
            Allocation.ToggleTimer(Court);

        _pendingPick = null;
        _showEndGame = false;
    }

    public void Dispose() => _timer?.Dispose();
}
