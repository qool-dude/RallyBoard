@inherits LayoutComponentBase
@inject SessionService Sessions
@inject AdminService Admin
@inject NavigationManager Nav
@implements IDisposable

<div class="page @(Sessions.IsTestMode ? "page--test" : "page--live") @(Admin.IsAdmin ? "page--admin" : "")">
    <header class="site-header">
        <div class="site-header__inner">
            <a href="/" class="brand">
                <span class="brand__mark">🏸</span>
                <span class="brand__wordmark">Rally<em>Board</em></span>
            </a>
            <nav class="site-nav">
                @if (Admin.IsAdmin)
                {
                    <a href="/" class="site-nav__link">Courts</a>
                    <a href="/dashboard" class="site-nav__link">Dashboard</a>
                    @if (!IsCourtsPage)
                    {
                        <a href="/dashboard/picks" class="site-nav__link">Picks</a>
                        <a href="/dashboard/matchmaking" class="site-nav__link">Pick settings</a>
                    }
                }
            </nav>
            @if (Admin.IsAdmin && !IsCourtsPage)
            {
                <div class="mode-toggle" role="group" aria-label="Data mode">
                    <button type="button"
                            class="mode-toggle__btn @(Sessions.IsTestMode ? "is-active" : "")"
                            @onclick="() => SetMode(true)">
                        Test
                    </button>
                    <button type="button"
                            class="mode-toggle__btn @(!Sessions.IsTestMode ? "is-active" : "")"
                            @onclick="() => SetMode(false)">
                        Live
                    </button>
                </div>
            }
            <StatsTicker />
        </div>
    </header>

    <main>
        @Body
    </main>

    <footer class="site-footer">
        <span>RallyBoard — drag, drop, play.</span>
        @if (Sessions.IsTestMode)
        {
            <span class="mode-footer-badge">Test mode</span>
        }
        @if (Admin.IsAdmin)
        {
            <span class="mode-footer-badge mode-footer-badge--admin">Admin</span>
        }
    </footer>
</div>

@code {
    private bool IsCourtsPage
    {
        get
        {
            var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
            return string.IsNullOrEmpty(path) || path == "/";
        }
    }

    private bool IsAdminOnlyPage
    {
        get
        {
            var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
            return path.StartsWith("/dashboard", StringComparison.OrdinalIgnoreCase);
        }
    }

    protected override void OnInitialized()
    {
        Sessions.OnChange += Refresh;
        Sessions.ModeChanged += Refresh;
        Admin.OnChange += OnAdminChanged;
        Nav.LocationChanged += OnLocationChanged;
        EnforceAdminGate();
    }

    private void SetMode(bool isTest) => Sessions.SetTestMode(isTest);

    private void OnAdminChanged()
    {
        EnforceAdminGate();
        InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        EnforceAdminGate();
        InvokeAsync(StateHasChanged);
    }

    private void EnforceAdminGate()
    {
        if (!Admin.IsAdmin && IsAdminOnlyPage)
            Nav.NavigateTo("/", replace: true);
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Sessions.OnChange -= Refresh;
        Sessions.ModeChanged -= Refresh;
        Admin.OnChange -= OnAdminChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
