@inherits LayoutComponentBase
@inject SessionService Sessions
@inject NavigationManager Nav
@implements IDisposable

<div class="page @(Sessions.IsTestMode ? "page--test" : "page--live")">
    <header class="site-header">
        <div class="site-header__inner">
            <a href="/" class="brand">
                <span class="brand__mark">🏸</span>
                <span class="brand__wordmark">Rally<em>Board</em></span>
            </a>
            <nav class="site-nav">
                <a href="/" class="site-nav__link">Courts</a>
                <a href="/dashboard" class="site-nav__link">Dashboard</a>
                @if (!IsCourtsPage)
                {
                    <a href="/dashboard/picks" class="site-nav__link">Picks</a>
                }
            </nav>
            @if (!IsCourtsPage)
            {
                <div class="mode-toggle" role="group" aria-label="Data mode">
                    <button type="button"
                            class="mode-toggle__btn @(Sessions.IsTestMode ? "is-active" : "")"
                            @onclick="() => SetMode(true)">
                        Test
                    </button>
                    <button type="button"
                            class="mode-toggle__btn @(!Sessions.IsTestMode ? "is-active" : "")"
                            @onclick="() => SetMode(false)">
                        Live
                    </button>
                </div>
            }
            <span class="tagline">Doubles court allocator</span>
        </div>
    </header>

    <main>
        @Body
    </main>

    <footer class="site-footer">
        <span>RallyBoard — drag, drop, play.</span>
        @if (Sessions.IsTestMode)
        {
            <span class="mode-footer-badge">Test mode</span>
        }
    </footer>
</div>

@code {
    private bool IsCourtsPage
    {
        get
        {
            var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
            return string.IsNullOrEmpty(path) || path == "/";
        }
    }

    protected override void OnInitialized()
    {
        Sessions.OnChange += Refresh;
        Sessions.ModeChanged += Refresh;
        Nav.LocationChanged += OnLocationChanged;
    }

    private void SetMode(bool isTest) => Sessions.SetTestMode(isTest);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        InvokeAsync(StateHasChanged);

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Sessions.OnChange -= Refresh;
        Sessions.ModeChanged -= Refresh;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
