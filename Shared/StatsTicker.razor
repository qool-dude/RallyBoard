@inject SessionService Sessions
@inject CourtAllocationService Allocation
@implements IDisposable

@if (_items.Count > 0)
{
    <div class="stats-ticker" aria-label="Session stats">
        <div class="stats-ticker__track">
            @foreach (var pass in Enumerable.Range(0, 2))
            {
                <div class="stats-ticker__pass" aria-hidden="@(pass > 0 ? "true" : null)">
                    @foreach (var item in _items)
                    {
                        <span class="stats-ticker__item">@item</span>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    private List<string> _items = new();

    private CancellationTokenSource? _rebuildCts;

    protected override void OnInitialized()
    {
        Rebuild();
        Sessions.OnChange += OnChanged;
        Sessions.ModeChanged += OnChanged;
        Allocation.OnChange += OnChanged;
    }

    private void OnChanged()
    {
        _rebuildCts?.Cancel();
        _rebuildCts?.Dispose();
        _rebuildCts = new CancellationTokenSource();
        var token = _rebuildCts.Token;

        // Coalesce ModeChanged + Allocation.OnChange (+ any burst) into one rebuild.
        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(50, token);
            }
            catch (TaskCanceledException)
            {
                return;
            }

            Rebuild();
            StateHasChanged();
        });
    }

    private void Rebuild()
    {
        var items = new List<string>();

        try
        {
            var sessionId = Sessions.CurrentSessionId;
            var stats = Sessions.GetSessionStats(sessionId);
            // Avoid GetRankings — it recomputes global ratings across all games.
            var recent = Sessions.GetRecentGames(sessionId, 6);
            var onCourt = Allocation.Courts.Sum(c => c.FilledCount);
            var waiting = Allocation.Waiting.Count;
            var session = Sessions.GetCurrentSession();
            var sessionLabel = string.IsNullOrWhiteSpace(session.Name)
                ? session.Date.ToString("ddd d MMM")
                : session.Name;

            items.Add($"{sessionLabel} is live");

            if (stats.TotalGames > 0)
                items.Add($"{stats.TotalGames} game{(stats.TotalGames == 1 ? "" : "s")} in the book");
            else
                items.Add("No games yet — first rally wins bragging rights");

            if (stats.TotalPlayers > 0)
                items.Add($"{stats.TotalPlayers} player{(stats.TotalPlayers == 1 ? "" : "s")} checked in");

            if (onCourt + waiting > 0)
                items.Add($"{onCourt} on court · {waiting} waiting");

            var closest = recent
                .Where(g => g.TeamAScore is int && g.TeamBScore is int)
                .Select(g => (Game: g, Margin: Math.Abs(g.TeamAScore!.Value - g.TeamBScore!.Value)))
                .OrderBy(x => x.Margin)
                .ThenByDescending(x => x.Game.EndedAt)
                .FirstOrDefault();
            if (closest.Game is not null)
            {
                var g = closest.Game;
                items.Add(closest.Margin <= 2
                    ? $"Nail-biter: {g.TeamAScore}–{g.TeamBScore} on court {g.CourtId}"
                    : $"Latest scoreboard: {g.TeamAScore}–{g.TeamBScore}");
            }

            var blowout = recent
                .Where(g => g.TeamAScore is int && g.TeamBScore is int)
                .Select(g => (Game: g, Margin: Math.Abs(g.TeamAScore!.Value - g.TeamBScore!.Value)))
                .OrderByDescending(x => x.Margin)
                .FirstOrDefault();
            if (blowout.Game is not null && blowout.Margin >= 8)
                items.Add($"Statement win: {blowout.Game.TeamAScore}–{blowout.Game.TeamBScore}");

            if (stats.UnpaidCount > 0)
                items.Add($"{stats.UnpaidCount} still owe court fees");
            else if (stats.PaidCount > 0)
                items.Add("Everyone's paid up — legends");

            if (Allocation.Courts.Count(c => c.IsRunning) is int running && running > 0)
                items.Add($"{running} court{(running == 1 ? "" : "s")} mid-rally");
        }
        catch
        {
            items.Add("RallyBoard — drag, drop, play");
        }

        if (items.Count == 0)
            items.Add("Ready when you are");

        // Keep the loop readable — pad if too short
        while (items.Count > 0 && items.Count < 4)
            items.AddRange(items.ToList());

        _items = items;
    }

    public void Dispose()
    {
        _rebuildCts?.Cancel();
        _rebuildCts?.Dispose();
        Sessions.OnChange -= OnChanged;
        Sessions.ModeChanged -= OnChanged;
        Allocation.OnChange -= OnChanged;
    }
}
