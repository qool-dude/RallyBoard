@inject CourtAllocationService Allocation
@implements IDisposable

<section class="waiting @(_dragOver ? "waiting--dragover" : "")"
          @ondragover="@(() => { })" @ondragover:preventDefault
          @ondragenter="() => _dragOver = true"
          @ondragleave="() => _dragOver = false"
          @ondrop="HandleDrop" @ondrop:preventDefault>
    <div class="waiting__head">
        <h3>Waiting Pool <span class="waiting__count">@ActiveWaiting.Count</span></h3>
    </div>

    @if (ActiveWaiting.Count == 0)
    {
        <p class="waiting__empty">
            @(PausedWaiting.Count == 0
                ? "Nobody's waiting — add players from the bar above."
                : "No players waiting — paused players are listed below.")
        </p>
    }
    else
    {
        <div class="waiting__chips">
            @foreach (var player in ActiveWaiting)
            {
                <PlayerChip @key="player.Id" Player="player" IsWaiting="true" />
            }
        </div>
    }

    @if (PausedWaiting.Count > 0)
    {
        <div class="waiting__paused">
            <h4 class="waiting__paused-heading">
                Paused Players
                <span class="waiting__count">@PausedWaiting.Count</span>
            </h4>
            <div class="waiting__chips">
                @foreach (var player in PausedWaiting)
                {
                    <PlayerChip @key="player.Id" Player="player" IsWaiting="true" />
                }
            </div>
        </div>
    }
</section>

@code {
    private bool _dragOver;

    private List<Player> ActiveWaiting =>
        Allocation.Waiting
            .Where(p => !p.IsPaused)
            .OrderByDescending(p => p.GetWaitingElapsed())
            .ToList();

    private List<Player> PausedWaiting =>
        Allocation.Waiting
            .Where(p => p.IsPaused)
            .OrderBy(p => p.Name)
            .ToList();

    protected override void OnInitialized() => Allocation.OnChange += OnStateChanged;

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void HandleDrop()
    {
        _dragOver = false;
        Allocation.DropOnWaiting();
    }

    public void Dispose() => Allocation.OnChange -= OnStateChanged;
}
