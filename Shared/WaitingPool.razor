@inject CourtAllocationService Allocation
@implements IDisposable

<section class="waiting @(_dragOver ? "waiting--dragover" : "")"
          @ondragover="@(() => { })" @ondragover:preventDefault
          @ondragenter="() => _dragOver = true"
          @ondragleave="() => _dragOver = false"
          @ondrop="HandleDrop" @ondrop:preventDefault>
    <div class="waiting__head">
        <h3>Waiting Pool <span class="waiting__count">@Allocation.Waiting.Count</span></h3>
    </div>

    @if (Allocation.Waiting.Count == 0)
    {
        <p class="waiting__empty">Nobody's waiting — add players from the bar above.</p>
    }
    else
    {
        <div class="waiting__chips">
            @foreach (var player in Allocation.Waiting.OrderByDescending(r => r.GetWaitingElapsed()))
            {
                <PlayerChip @key="player.Id" Player="player" IsWaiting="true" />
            }
        </div>
    }
</section>

@code {
    private bool _dragOver;

    protected override void OnInitialized() => Allocation.OnChange += OnStateChanged;

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void HandleDrop()
    {
        _dragOver = false;
        Allocation.DropOnWaiting();
    }

    public void Dispose() => Allocation.OnChange -= OnStateChanged;
}
