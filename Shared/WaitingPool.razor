@inject CourtAllocationService Allocation
@implements IDisposable

<section class="waiting @(_dragOver ? "waiting--dragover" : "")"
          @ondragover="@(() => { })" @ondragover:preventDefault
          @ondragenter="() => _dragOver = true"
          @ondragleave="() => _dragOver = false"
          @ondrop="HandleDrop" @ondrop:preventDefault>
    <div class="waiting__head">
        <h3>Waiting Pool <span class="waiting__count">@Allocation.Waiting.Count</span></h3>
        <form class="waiting__add" @onsubmit="AddPlayer" @onsubmit:preventDefault>
            <input @bind="_newName" @bind:event="oninput" placeholder="Add a player…" />
            <button type="submit" class="btn btn-primary btn-sm">Add</button>
        </form>
    </div>

    @if (Allocation.Waiting.Count == 0)
    {
        <p class="waiting__empty">Nobody's waiting — drag a player here to bench them.</p>
    }
    else
    {
        <div class="waiting__chips">
            @foreach (var player in Allocation.Waiting.OrderByDescending(r => r.GetWaitingElapsed()))
            {
                <PlayerChip Player="player" IsWaiting="true" />
            }
        </div>
    }
</section>

@code {
    private string _newName = "";
    private bool _dragOver;

    protected override void OnInitialized()
    {
        // Subscribe to OnChange event to refresh when players are added/removed
        // (NOT to Tick, which would recreate child components and break their subscriptions)
        Allocation.OnChange += OnStateChanged;
    }

    private void OnStateChanged()
    {
        // Re-render only when the waiting pool list changes (players added/removed)
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Allocation.OnChange -= OnStateChanged;
    }

    private void AddPlayer()
    {
        Allocation.AddPlayer(_newName);
        _newName = "";
    }

    private void HandleDrop()
    {
        _dragOver = false;
        Allocation.DropOnWaiting();
    }
}
