@inject CourtAllocationService Allocation
@inject SessionService Sessions
@implements IDisposable

<div class="chip chip--@(Player.ColorIndex % 6) @(IsWaiting ? "chip--waiting" : "") @(_dragOver ? "chip--dragover" : "") @(_menuOpen ? "chip--menu-open" : "") @(Locked ? "chip--locked" : "") @(Player.IsPaused ? "chip--paused" : "")"
     draggable="@(CanDrag ? "true" : "false")"
     @ondragstart="OnDragStart"
     @ondragstart:stopPropagation
     @ondragover="@(() => { })" @ondragover:preventDefault
     @ondragenter="() => { if (!Locked && !Player.IsPaused) _dragOver = true; }"
     @ondragleave="() => _dragOver = false"
     @ondrop="HandleDrop" @ondrop:preventDefault @ondrop:stopPropagation>
    @if (_menuOpen)
    {
        <div class="chip-menu-backdrop" @onclick="CloseMenu" @onmousedown:preventDefault></div>
    }
    <span class="chip__avatar">
        @Player.Initials
        @if (Sessions.IsPaid(Player.Id))
        {
            <span class="chip__paid" title="Paid" aria-label="Paid">
                <svg viewBox="0 0 12 12" aria-hidden="true" focusable="false">
                    <path d="M2.4 6.2l2.4 2.4 4.8-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </span>
        }
    </span>
    <span class="chip__name">@Player.Name</span>
    @if (IsWaiting)
    {
        <span class="chip__waiting">@FormatElapsed(Player.GetWaitingElapsed())</span>
        <button class="chip__pause-btn" title="@(Player.IsPaused ? "Resume" : "Pause")" @onclick="TogglePause" @onclick:stopPropagation>
            @(Player.IsPaused ? "▶" : "⏸")
        </button>
        <button class="chip__remove" title="Remove player" aria-label="Remove @Player.Name" @onclick="AskRemove" @onclick:stopPropagation>
            <svg class="chip__remove-icon" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
                <path d="M2.1 2.1l7.8 7.8M9.9 2.1L2.1 9.9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
        </button>
    }

    @if (ShowRemove && !Player.IsPaused)
    {
        <div class="chip__actions">
            <button class="chip__menu-btn" title="Actions" @onclick="ToggleMenu" @onclick:stopPropagation>▾</button>
            @if (_menuOpen)
            {
                <div class="chip__menu" @onclick:stopPropagation>
                    @if (UseGroupedSwapMenu)
                    {
                        var courtPlayers = PreferredSwapPlayers.ToList();
                        var remainingPlayers = OtherPlayers
                            .Where(p => courtPlayers.All(c => c.Id != p.Id))
                            .ToList();

                        @foreach (var other in courtPlayers)
                        {
                            <button class="chip__menu-item" @onclick="() => SwapWith(other)">@other.Name</button>
                        }
                        @if (courtPlayers.Count > 0 && remainingPlayers.Count > 0)
                        {
                            <hr />
                        }
                        @foreach (var other in remainingPlayers)
                        {
                            <button class="chip__menu-item" @onclick="() => SwapWith(other)">@other.Name</button>
                        }
                    }
                    else
                    {
                        @foreach (var other in OtherPlayers)
                        {
                            <button class="chip__menu-item" @onclick="() => SwapWith(other)">@other.Name</button>
                        }
                    }
                    @if (AllowRemove)
                    {
                        <hr />
                        <button class="chip__menu-item" @onclick="() => Remove()">Remove</button>
                    }
                </div>
            }
        </div>
    }
</div>

@if (_confirmRemove)
{
    <div class="modal-backdrop" @onclick="CancelRemove">
        <div class="modal-panel confirm-panel" @onclick:stopPropagation role="alertdialog" aria-modal="true" aria-labelledby="remove-player-title">
            <div class="modal-panel__head">
                <h3 id="remove-player-title">Remove @Player.Name?</h3>
                <button type="button" class="modal-panel__close" @onclick="CancelRemove" aria-label="Cancel">&times;</button>
            </div>
            <p class="modal-panel__hint">@Player.Name will be removed from the waiting pool. They can be added again later.</p>
            <div class="modal-panel__actions">
                <button type="button" class="btn btn-ghost" @onclick="CancelRemove">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="ConfirmRemove">Remove player</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public Player Player { get; set; } = null!;
    [Parameter] public bool ShowRemove { get; set; } = true;
    [Parameter] public bool IsWaiting { get; set; }
    [Parameter] public bool Locked { get; set; }
    [Parameter] public bool AllowRemove { get; set; } = true;
    [Parameter] public IEnumerable<Player>? SwapCandidates { get; set; }
    [Parameter] public IEnumerable<Player>? PrimarySwapCandidates { get; set; }
    [Parameter] public EventCallback<Player> DragStarted { get; set; }
    [Parameter] public EventCallback<Player> DroppedOn { get; set; }
    [Parameter] public EventCallback<Player> SwapRequested { get; set; }

    private bool _menuOpen;
    private bool _dragOver;
    private bool _confirmRemove;
    private Guid _boundPlayerId;

    private bool CanDrag => !Locked && !Player.IsPaused && !_menuOpen && !_confirmRemove;
    private bool UseGroupedSwapMenu =>
        PrimarySwapCandidates is not null || (!IsWaiting && SwapCandidates is null);

    private IEnumerable<Player> PreferredSwapPlayers =>
        PrimarySwapCandidates?.Where(p => p.Id != Player.Id).DistinctBy(p => p.Id)
        ?? Allocation.Courts
                .FirstOrDefault(c => c.Slots.Any(p => p?.Id == Player.Id))
                ?.Slots
                .OfType<Player>()
                .Where(p => p.Id != Player.Id)
        ?? Enumerable.Empty<Player>();

    protected override void OnParametersSet()
    {
        // Component reused for a different player — never keep another chip's menu open
        if (_boundPlayerId != Player.Id)
        {
            _boundPlayerId = Player.Id;
            _menuOpen = false;
            _dragOver = false;
            _confirmRemove = false;
        }

        if (Locked || Player.IsPaused)
            _menuOpen = false;
    }

    private async Task OnDragStart(DragEventArgs e)
    {
        if (!CanDrag)
        {
            e.DataTransfer.EffectAllowed = "none";
            return;
        }

        e.DataTransfer.EffectAllowed = "move";

        if (DragStarted.HasDelegate)
            await DragStarted.InvokeAsync(Player);
        else
            Allocation.StartDrag(Player);
    }

    private async Task HandleDrop()
    {
        _dragOver = false;
        if (Locked || Player.IsPaused) return;
        if (DroppedOn.HasDelegate)
            await DroppedOn.InvokeAsync(Player);
        else
            Allocation.DropOnPlayer(Player);
    }

    private void ToggleMenu()
    {
        if (Locked || Player.IsPaused) return;
        if (_menuOpen)
        {
            CloseMenu();
            return;
        }

        Allocation.NotifyChipMenuOpening(Player.Id);
        _menuOpen = true;
    }

    private void CloseMenu()
    {
        if (!_menuOpen) return;
        _menuOpen = false;
    }

    private void Remove()
    {
        CloseMenu();
        Allocation.DeletePlayer(Player);
    }

    private void AskRemove() => _confirmRemove = true;

    private void CancelRemove() => _confirmRemove = false;

    private void ConfirmRemove()
    {
        _confirmRemove = false;
        Remove();
    }

    private void TogglePause()
    {
        Allocation.TogglePause(Player);
    }

    private static string FormatElapsed(TimeSpan ts)
    {
        if (ts.TotalHours >= 1)
            return string.Format("{0:%h}h {0:%m}m", ts);
        if (ts.TotalMinutes >= 1)
            return string.Format("{0:%m}m {0:ss}s", ts);
        return string.Format("{0:ss}s", ts);
    }

    private IEnumerable<Player> OtherPlayers
    {
        get
        {
            if (SwapCandidates is not null)
            {
                return SwapCandidates
                    .Where(p => p.Id != Player.Id)
                    .DistinctBy(p => p.Id);
            }

            // Waiting pool: swap only with someone already on court (unlocked lineups)
            if (IsWaiting)
            {
                return Allocation.Courts
                    .Where(c => !c.LineupLocked)
                    .SelectMany(c => c.Slots)
                    .Where(p => p is not null && p.Id != Player.Id)
                    .Cast<Player>()
                    .DistinctBy(p => p.Id);
            }

            var list = new List<Player>();
            list.AddRange(Allocation.Waiting.Where(p => !p.IsPaused));
            foreach (var court in Allocation.Courts.Where(c => !c.LineupLocked))
                foreach (var slot in court.Slots)
                    if (slot is not null) list.Add(slot);
            return list.Where(p => p.Id != Player.Id).DistinctBy(p => p.Id);
        }
    }

    private async Task SwapWith(Player other)
    {
        CloseMenu();
        if (SwapRequested.HasDelegate)
            await SwapRequested.InvokeAsync(other);
        else
            Allocation.SwapPlayers(Player, other);
    }

    protected override void OnInitialized()
    {
        _boundPlayerId = Player.Id;
        Allocation.Tick += OnTick;
        Allocation.OnChange += OnBoardChanged;
        Allocation.ChipMenuOpening += OnOtherMenuOpening;
        Sessions.OnChange += OnPaidChanged;
    }

    private void OnPaidChanged() => InvokeAsync(StateHasChanged);

    private void OnOtherMenuOpening(Guid playerId)
    {
        if (playerId == Player.Id || !_menuOpen) return;
        _menuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    private void OnBoardChanged()
    {
        if (!_menuOpen) return;
        _menuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    private void OnTick()
    {
        if (IsWaiting)
            InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Allocation.Tick -= OnTick;
        Allocation.OnChange -= OnBoardChanged;
        Allocation.ChipMenuOpening -= OnOtherMenuOpening;
        Sessions.OnChange -= OnPaidChanged;
    }
}
