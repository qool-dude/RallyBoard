@page "/"
@inject CourtAllocationService Allocation
@inject SessionService Sessions
@inject AdminService Admin
@implements IDisposable

<PageTitle>RallyBoard — Badminton Court Allocator</PageTitle>

<section class="toolbar">
    <div class="toolbar__group">
        <label class="toolbar__label">Session</label>
        <span class="session-name session-name--readonly">@_sessionName</span>
        @if (Sessions.IsTestMode)
        {
            <span class="mode-pill">Test</span>
        }
        @if (Admin.IsAdmin)
        {
            <span class="mode-pill mode-pill--admin">Admin</span>
        }
    </div>

    <div class="toolbar__group toolbar__group--add">
        <AddPlayerPicker />
        @if (!Admin.IsAdmin)
        {
            <div class="overflow-menu">
                <button type="button"
                        class="overflow-menu__btn"
                        title="More"
                        aria-haspopup="menu"
                        aria-expanded="@_overflowOpen"
                        @onclick="ToggleOverflow">
                    ⋮
                </button>
                @if (_overflowOpen)
                {
                    <div class="chip-menu-backdrop" @onclick="CloseOverflow"></div>
                    <div class="overflow-menu__panel" role="menu" @onclick:stopPropagation>
                        <button type="button" class="overflow-menu__item" role="menuitem" @onclick="OpenAdminLogin">Admin login</button>
                    </div>
                }
            </div>
        }
    </div>
</section>

@if (Admin.IsAdmin)
{
    <div class="admin-bar">
        <div class="admin-bar__left">
            <span class="admin-bar__label">Admin mode</span>
            <div class="admin-bar__group">
                <label class="admin-bar__field-label" for="admin-court-count">Courts</label>
                <div class="stepper" id="admin-court-count">
                    <button type="button" @onclick="() => SetCourts(Allocation.Courts.Count - 1)" aria-label="Fewer courts">&minus;</button>
                    <span>@Allocation.Courts.Count</span>
                    <button type="button" @onclick="() => SetCourts(Allocation.Courts.Count + 1)" aria-label="More courts">+</button>
                </div>
            </div>
            <div class="admin-bar__actions">
                <button type="button" class="btn btn-ghost btn-sm" @onclick="ShuffleClick">Shuffle everyone</button>
                <button type="button" class="btn btn-ghost btn-sm" @onclick="Allocation.StartAllTimers">Start all games</button>
                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => AskConfirm(ConfirmAction.Clear)">Clear all courts</button>
            </div>
        </div>
        <button type="button" class="btn btn-ghost btn-sm" @onclick="ExitAdmin">Return to normal mode</button>
    </div>
}

<section class="courts-grid">
    @foreach (var court in Allocation.Courts)
    {
        <CourtCard Court="court" />
    }
</section>

<WaitingPool />

@if (_showAdminLogin)
{
    <div class="modal-backdrop" @onclick="CancelAdminLogin">
        <div class="modal-panel confirm-panel admin-login-modal" @onclick:stopPropagation role="dialog" aria-modal="true" aria-labelledby="admin-login-title">
            <div class="modal-panel__head">
                <h3 id="admin-login-title">Admin login</h3>
                <button type="button" class="modal-panel__close" @onclick="CancelAdminLogin" aria-label="Cancel">&times;</button>
            </div>
            <form class="admin-login-form" @onsubmit="SubmitAdminLogin" @onsubmit:preventDefault>
                <label class="admin-login-form__label" for="admin-password">Password</label>
                <input id="admin-password"
                       @ref="_adminPasswordInput"
                       class="admin-login-form__input"
                       type="password"
                       value="@_adminPassword"
                       @oninput="OnAdminPasswordInput"
                       autocomplete="off"
                       spellcheck="false" />
                @if (!string.IsNullOrEmpty(_adminError))
                {
                    <p class="admin-login-form__error">@_adminError</p>
                }
                <div class="modal-panel__actions">
                    <button type="button" class="btn btn-ghost" @onclick="CancelAdminLogin">Cancel</button>
                    <button type="submit" class="btn btn-primary">Enter admin</button>
                </div>
            </form>
        </div>
    </div>
}

@if (_pending is ConfirmAction action)
{
    <div class="modal-backdrop" @onclick="CancelConfirm">
        <div class="modal-panel confirm-panel" @onclick:stopPropagation role="dialog" aria-modal="true" aria-labelledby="confirm-title">
            <div class="modal-panel__head">
                <h3 id="confirm-title">@ConfirmTitle(action)</h3>
                <button type="button" class="modal-panel__close" @onclick="CancelConfirm" aria-label="Cancel">&times;</button>
            </div>
            <p class="modal-panel__hint">@ConfirmMessage(action)</p>
            <div class="modal-panel__actions">
                <button type="button" class="btn btn-ghost" @onclick="CancelConfirm">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="RunConfirm">@ConfirmButton(action)</button>
            </div>
        </div>
    </div>
}

@code {
    private enum ConfirmAction { Shuffle, Clear }

    private string _sessionName = "";
    private ConfirmAction? _pending;
    private bool _overflowOpen;
    private bool _showAdminLogin;
    private bool _focusAdminPassword;
    private string _adminPassword = "";
    private string _adminError = "";
    private ElementReference _adminPasswordInput;

    protected override void OnInitialized()
    {
        Allocation.OnChange += Refresh;
        Sessions.OnChange += RefreshSession;
        Sessions.ModeChanged += RefreshSession;
        Admin.OnChange += Refresh;
        RefreshSession();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusAdminPassword && _showAdminLogin)
        {
            _focusAdminPassword = false;
            try
            {
                await _adminPasswordInput.FocusAsync();
            }
            catch
            {
                // Element may not be ready yet
            }
        }
    }

    private void ToggleOverflow() => _overflowOpen = !_overflowOpen;
    private void CloseOverflow() => _overflowOpen = false;

    private void OpenAdminLogin()
    {
        CloseOverflow();
        _adminPassword = "";
        _adminError = "";
        _showAdminLogin = true;
        _focusAdminPassword = true;
    }

    private void CancelAdminLogin()
    {
        _showAdminLogin = false;
        _adminPassword = "";
        _adminError = "";
    }

    private void OnAdminPasswordInput(ChangeEventArgs e)
    {
        _adminPassword = e.Value?.ToString() ?? "";
        _adminError = "";

        // Accept as soon as the correct password is fully typed
        if (Admin.TryLogin(_adminPassword))
            CancelAdminLogin();
    }

    private void SubmitAdminLogin()
    {
        if (Admin.TryLogin(_adminPassword))
        {
            CancelAdminLogin();
            return;
        }

        _adminError = "Incorrect password.";
        _adminPassword = "";
        _focusAdminPassword = true;
    }

    private void ExitAdmin()
    {
        CloseOverflow();
        Admin.Logout();
    }

    private void AskConfirm(ConfirmAction action) => _pending = action;

    private void ShuffleClick()
    {
        if (Allocation.Courts.All(c => c.FilledCount == 0))
        {
            Allocation.ShuffleAll();
            return;
        }

        AskConfirm(ConfirmAction.Shuffle);
    }

    private void CancelConfirm() => _pending = null;

    private void RunConfirm()
    {
        switch (_pending)
        {
            case ConfirmAction.Shuffle:
                Allocation.ShuffleAll();
                break;
            case ConfirmAction.Clear:
                Allocation.ClearAllCourts();
                break;
        }
        _pending = null;
    }

    private static string ConfirmTitle(ConfirmAction action) => action switch
    {
        ConfirmAction.Shuffle => "Shuffle everyone?",
        ConfirmAction.Clear => "Clear all courts?",
        _ => "Confirm"
    };

    private static string ConfirmMessage(ConfirmAction action) => action switch
    {
        ConfirmAction.Shuffle => "This pulls everyone off the courts and rematches them. Timers will not start — hit play on each court when ready.",
        ConfirmAction.Clear => "Everyone on court will be sent back to the waiting pool. Timers will stop.",
        _ => ""
    };

    private static string ConfirmButton(ConfirmAction action) => action switch
    {
        ConfirmAction.Shuffle => "Shuffle",
        ConfirmAction.Clear => "Clear courts",
        _ => "Confirm"
    };

    private void Refresh() => InvokeAsync(StateHasChanged);

    private void RefreshSession()
    {
        var session = Sessions.GetCurrentSession();
        _sessionName = string.IsNullOrWhiteSpace(session.Name)
            ? session.Date.ToString("ddd d MMM yyyy")
            : session.Name;
        InvokeAsync(StateHasChanged);
    }

    private void SetCourts(int count) => Allocation.SetCourtCount(count);

    public void Dispose()
    {
        Allocation.OnChange -= Refresh;
        Sessions.OnChange -= RefreshSession;
        Sessions.ModeChanged -= RefreshSession;
        Admin.OnChange -= Refresh;
    }
}
