@page "/dashboard"
@inject SessionService Sessions
@inject CourtAllocationService Allocation
@implements IDisposable

<PageTitle>RallyBoard — Dashboard</PageTitle>

<section class="dashboard">
    <div class="dashboard__head">
        <div>
            <h1>Session dashboard @(Sessions.IsTestMode ? "(Test)" : "(Live)")</h1>
            <p class="dashboard__subtitle">Rankings, attendance, and game history</p>
        </div>
        <div class="dashboard__head-actions">
            <button class="btn btn-ghost" @onclick="OpenSessionManager">Manage sessions</button>
            <a class="btn btn-ghost" href="/dashboard/picks">Picks</a>
            <a class="btn btn-ghost" href="/dashboard/matchmaking">Pick settings</a>
            <a class="btn btn-primary" href="/">Back to courts</a>
        </div>
    </div>

    <div class="dashboard__session-bar">
        <label class="dashboard__label" for="session-select">Session</label>
        <select id="session-select" class="dashboard__select" @bind="_selectedKey" @bind:after="LoadData">
            <option value="@AllSessionsKey">All sessions</option>
            @foreach (var session in _sessions)
            {
                <option value="@session.Id.ToString()">
                    @(string.IsNullOrWhiteSpace(session.Name) ? session.Date.ToString("ddd d MMM yyyy") : session.Name)
                    @(session.IsActive ? " (active)" : "")
                    — @session.GameCount games, @session.PlayerCount players
                </option>
            }
        </select>
    </div>

    @if (_stats is not null)
    {
        <div class="stats-grid">
            <div class="stat-card">
                <span class="stat-card__value">@_stats.TotalGames</span>
                <span class="stat-card__label">Games played</span>
            </div>
            <div class="stat-card">
                <span class="stat-card__value">@_stats.TotalPlayers</span>
                <span class="stat-card__label">Players attended</span>
            </div>
            <div class="stat-card stat-card--paid">
                <span class="stat-card__value">@_stats.PaidCount</span>
                <span class="stat-card__label">Paid</span>
            </div>
            <div class="stat-card stat-card--unpaid">
                <span class="stat-card__value">@_stats.UnpaidCount</span>
                <span class="stat-card__label">Unpaid</span>
            </div>
        </div>
    }

    <div class="dashboard__grid">
        <section class="dashboard-panel dashboard-panel--rankings">
            <div class="dashboard-panel__head">
                <h2>Rankings</h2>
                @if (_isAllSessions)
                {
                    <span class="dashboard-panel__badge">All sessions</span>
                }
                else if (_isCurrentSession)
                {
                    <span class="dashboard-panel__badge">Current session</span>
                }
            </div>

            @if (_rankings.Count == 0)
            {
                <p class="dashboard__empty">No games recorded yet@(_isAllSessions ? "." : " for this session.")</p>
            }
            else
            {
                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Player</th>
                                <th>Rating</th>
                                <th>G</th>
                                <th>W</th>
                                <th>L</th>
                                <th>Win%</th>
                                <th>Close</th>
                                <th>Pts +</th>
                                <th>Pts −</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < _rankings.Count; i++)
                            {
                                var row = _rankings[i];
                                var rank = i + 1;
                                <tr class="@(rank <= 3 ? $"data-table__row--top{rank}" : "")">
                                    <td class="data-table__rank">@rank</td>
                                    <td class="data-table__name">@row.Name</td>
                                    <td class="data-table__rating">@row.Rating.ToString("0.#")</td>
                                    <td>@row.Games</td>
                                    <td>@row.Wins</td>
                                    <td>@row.Losses</td>
                                    <td>@row.WinRate.ToString("0.#")%</td>
                                    <td>@row.Closeness.ToString("0.#")</td>
                                    <td>@row.PointsFor</td>
                                    <td>@row.PointsAgainst</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="dashboard-panel dashboard-panel--attendance">
            <div class="dashboard-panel__head">
                <h2>Attendance</h2>
                <div class="dashboard-panel__actions">
                    @if (!_isAllSessions)
                    {
                        <label class="attendance-filter">
                            <select class="attendance-filter__select" @bind="_attendanceFilter" aria-label="Filter attendance">
                                <option value="all">All</option>
                                <option value="paid">Paid</option>
                                <option value="unpaid">Unpaid</option>
                            </select>
                        </label>
                    }
                    @if (_isCurrentSession)
                    {
                        <button type="button" class="btn btn-ghost btn-sm" @onclick="SelectAllAttendance">Select all</button>
                        <button type="button" class="btn btn-ghost btn-sm" @onclick="ClearAllAttendance">Clear all</button>
                    }
                </div>
            </div>

            @if (_isAllSessions)
            {
                <p class="dashboard__hint">Players who have attended any session.</p>
                <div class="attendance-list">
                    @foreach (var row in _rankings.OrderBy(r => r.Name))
                    {
                        <div class="attendance-row attendance-row--present">
                            @if (_editingPlayerId == row.PlayerId)
                            {
                                <form class="attendance-row__rename" @onsubmit="SavePlayerName" @onsubmit:preventDefault>
                                    <input class="attendance-row__name-input" @bind="_playerNameEdit" @bind:event="oninput" aria-label="Player name" />
                                    <button type="submit" class="btn btn-primary btn-sm">Save</button>
                                    <button type="button" class="btn btn-ghost btn-sm" @onclick="CancelEditPlayer">Cancel</button>
                                </form>
                            }
                            else
                            {
                                <span class="attendance-row__name">@row.Name</span>
                                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => StartEditPlayer(row.PlayerId, row.Name)">Rename</button>
                            }
                        </div>
                    }
                    @if (_rankings.Count == 0)
                    {
                        <p class="dashboard__empty">No attendance recorded.</p>
                    }
                </div>
            }
            else if (_isCurrentSession)
            {
                <p class="dashboard__hint">Tick players who attended tonight and record their payment status.</p>
                <div class="attendance-list">
                    @{
                        var currentRows = FilteredCurrentAttendance.ToList();
                    }
                    @foreach (var player in currentRows)
                    {
                        var present = _attendeeIds.Contains(player.Id);
                        var ranking = _rankings.FirstOrDefault(r => r.PlayerId == player.Id);
                        <div @key="player.Id" class="attendance-row @(present ? "attendance-row--present" : "")">
                            <input type="checkbox"
                                   checked="@present"
                                   @onchange="e => ToggleAttendance(player.Id, (bool)(e.Value ?? false))" />
                            <span class="attendance-row__avatar chip--@(player.ColorIndex % 6)">@player.Initials</span>
                            @if (_editingPlayerId == player.Id)
                            {
                                <form class="attendance-row__rename" @onsubmit="SavePlayerName" @onsubmit:preventDefault>
                                    <input class="attendance-row__name-input" @bind="_playerNameEdit" @bind:event="oninput" aria-label="Player name" />
                                    <button type="submit" class="btn btn-primary btn-sm">Save</button>
                                    <button type="button" class="btn btn-ghost btn-sm" @onclick="CancelEditPlayer">Cancel</button>
                                </form>
                            }
                            else
                            {
                                <span class="attendance-row__name">@player.Name</span>
                                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => StartEditPlayer(player.Id, player.Name)">Rename</button>
                            }
                            <label class="attendance-row__paid-check">
                                <input type="checkbox"
                                       checked="@(ranking?.HasPaid ?? false)"
                                       disabled="@(!present)"
                                       @onchange="e => TogglePaid(player.Id, (bool)(e.Value ?? false))" />
                                <span>Paid</span>
                            </label>
                        </div>
                    }
                    @if (currentRows.Count == 0)
                    {
                        <p class="dashboard__empty">No players match this filter.</p>
                    }
                </div>
            }
            else
            {
                <div class="attendance-list">
                    @{
                        var pastRows = FilteredPastAttendance.ToList();
                    }
                    @foreach (var row in pastRows)
                    {
                        <div @key="row.PlayerId" class="attendance-row attendance-row--present">
                            @if (_editingPlayerId == row.PlayerId)
                            {
                                <form class="attendance-row__rename" @onsubmit="SavePlayerName" @onsubmit:preventDefault>
                                    <input class="attendance-row__name-input" @bind="_playerNameEdit" @bind:event="oninput" aria-label="Player name" />
                                    <button type="submit" class="btn btn-primary btn-sm">Save</button>
                                    <button type="button" class="btn btn-ghost btn-sm" @onclick="CancelEditPlayer">Cancel</button>
                                </form>
                            }
                            else
                            {
                                <span class="attendance-row__name">@row.Name</span>
                                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => StartEditPlayer(row.PlayerId, row.Name)">Rename</button>
                            }
                            <label class="attendance-row__paid-check">
                                <input type="checkbox"
                                       checked="@row.HasPaid"
                                       @onchange="e => TogglePaid(row.PlayerId, (bool)(e.Value ?? false))" />
                                <span>Paid</span>
                            </label>
                        </div>
                    }
                    @if (pastRows.Count == 0)
                    {
                        <p class="dashboard__empty">No players match this filter.</p>
                    }
                </div>
            }
        </section>
    </div>

    <section class="dashboard-panel dashboard-panel--full">
        <div class="dashboard-panel__head">
            <h2>Recent games</h2>
        </div>

        @if (_recentGames.Count == 0)
        {
            <p class="dashboard__empty">No games yet.</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="data-table data-table--games">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Court</th>
                            <th>Winners</th>
                            <th>Runners-up</th>
                            <th class="data-table__score">Score</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var game in _recentGames)
                        {
                            var (winners, losers, score) = FormatGameResult(game);
                            <tr>
                                <td>@game.EndedAt.ToLocalTime().ToString("HH:mm")</td>
                                <td>Court @game.CourtId</td>
                                <td class="data-table__winner">@winners</td>
                                <td>@losers</td>
                                <td class="data-table__score">@score</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</section>

@if (_showSessionManager)
{
    <div class="modal-backdrop" @onclick="CloseSessionManager">
        <div class="modal-panel session-manager-modal" @onclick:stopPropagation role="dialog" aria-modal="true" aria-labelledby="session-manager-title">
            <div class="modal-panel__head">
                <h3 id="session-manager-title">Manage sessions</h3>
                <button type="button" class="modal-panel__close" @onclick="CloseSessionManager" aria-label="Close">&times;</button>
            </div>

            <div class="session-manager__list">
                @foreach (var session in _sessions)
                {
                    <div class="session-manager__item">
                        @if (_editingSessionId == session.Id)
                        {
                            <form class="session-manager__edit" @onsubmit="SaveSessionName" @onsubmit:preventDefault>
                                <input class="session-name-form__input" @bind="_sessionNameEdit" @bind:event="oninput" aria-label="Session name" />
                                <button type="submit" class="btn btn-primary btn-sm">Save</button>
                                <button type="button" class="btn btn-ghost btn-sm" @onclick="CancelEditName">Cancel</button>
                            </form>
                        }
                        else
                        {
                            <div class="session-manager__meta">
                                <strong>
                                    @(string.IsNullOrWhiteSpace(session.Name) ? session.Date.ToString("ddd d MMM yyyy") : session.Name)
                                    @if (session.IsActive)
                                    {
                                        <span class="session-manager__active">Active</span>
                                    }
                                </strong>
                                <span>@session.Date.ToString("ddd d MMM yyyy") · @session.GameCount games · @session.PlayerCount players</span>
                            </div>
                            <div class="session-manager__actions">
                                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => StartEditName(session.Id)">Edit</button>
                                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => AskDeleteSession(session.Id)">Delete</button>
                            </div>
                        }
                    </div>
                }
            </div>

            <form class="session-manager__create" @onsubmit="ConfirmCreateSession" @onsubmit:preventDefault>
                <label class="end-session-form__label" for="new-session-name">Add new session</label>
                <div class="session-manager__create-controls">
                    <input id="new-session-name" class="end-session-form__input" @bind="_newSessionName" placeholder="Session name…" />
                    <button type="submit" class="btn btn-primary btn-sm">Add session</button>
                </div>
            </form>
        </div>
    </div>
}

@if (_confirmDeleteSession && _sessionPendingDeleteId is Guid deleteSessionId)
{
    var session = _sessions.FirstOrDefault(s => s.Id == deleteSessionId);
    var displayName = session is null || string.IsNullOrWhiteSpace(session.Name)
        ? session?.Date.ToString("ddd d MMM yyyy") ?? "this session"
        : session.Name;

    <div class="modal-backdrop" @onclick="CancelDeleteSession">
        <div class="modal-panel confirm-panel" @onclick:stopPropagation role="alertdialog" aria-modal="true" aria-labelledby="delete-session-title">
            <div class="modal-panel__head">
                <h3 id="delete-session-title">Delete @displayName?</h3>
                <button type="button" class="modal-panel__close" @onclick="CancelDeleteSession" aria-label="Cancel">&times;</button>
            </div>
            <p class="modal-panel__hint">
                This permanently deletes the session, its attendance, @session?.GameCount game@(session?.GameCount == 1 ? "" : "s"),
                and associated pick history.
            </p>
            @if (deleteSessionId == Sessions.CurrentSessionId)
            {
                <p class="modal-panel__hint">This is the current session. RallyBoard will switch to another active session, or create a blank replacement if none exists.</p>
            }
            <div class="modal-panel__actions">
                <button type="button" class="btn btn-ghost" @onclick="CancelDeleteSession">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="ConfirmDeleteSession">Delete session</button>
            </div>
        </div>
    </div>
}

@code {
    private const string AllSessionsKey = "all";

    private List<SessionSummaryRow> _sessions = new();
    private List<PlayerRankingRow> _rankings = new();
    private List<GameSummaryRow> _recentGames = new();
    private List<Player> _allPlayers = new();
    private HashSet<Guid> _attendeeIds = new();
    private SessionStats? _stats;
    private string _selectedKey = AllSessionsKey;
    private Guid? _selectedSessionId;
    private bool _isCurrentSession;
    private bool _isAllSessions;
    private bool _showSessionManager;
    private string _newSessionName = "";
    private bool _confirmDeleteSession;
    private Guid? _sessionPendingDeleteId;
    private Guid? _editingSessionId;
    private string _sessionNameEdit = "";
    private Guid? _editingPlayerId;
    private string _playerNameEdit = "";
    private string _attendanceFilter = "all";

    private IEnumerable<Player> FilteredCurrentAttendance
    {
        get
        {
            var players = _allPlayers.AsEnumerable();
            return _attendanceFilter switch
            {
                "paid" => players.Where(p =>
                    _attendeeIds.Contains(p.Id) &&
                    (_rankings.FirstOrDefault(r => r.PlayerId == p.Id)?.HasPaid ?? false)),
                "unpaid" => players.Where(p =>
                    _attendeeIds.Contains(p.Id) &&
                    !(_rankings.FirstOrDefault(r => r.PlayerId == p.Id)?.HasPaid ?? false)),
                _ => players
            };
        }
    }

    private IEnumerable<PlayerRankingRow> FilteredPastAttendance
    {
        get
        {
            var rows = _rankings.OrderBy(r => r.Name).AsEnumerable();
            return _attendanceFilter switch
            {
                "paid" => rows.Where(r => r.HasPaid),
                "unpaid" => rows.Where(r => !r.HasPaid),
                _ => rows
            };
        }
    }

    protected override void OnInitialized()
    {
        Sessions.OnChange += Refresh;
        Sessions.ModeChanged += OnModeChanged;
        _selectedKey = Sessions.CurrentSessionId.ToString();
        LoadData();
    }

    private void OnModeChanged() => InvokeAsync(() =>
    {
        _selectedKey = Sessions.CurrentSessionId.ToString();
        _showSessionManager = false;
        _confirmDeleteSession = false;
        _sessionPendingDeleteId = null;
        _editingSessionId = null;
        _editingPlayerId = null;
        _attendanceFilter = "all";
        LoadData();
        StateHasChanged();
    });

    private void LoadData()
    {
        _sessions = Sessions.GetSessions();
        _isAllSessions = _selectedKey == AllSessionsKey;
        _selectedSessionId = _isAllSessions
            ? null
            : Guid.TryParse(_selectedKey, out var id) ? id : Sessions.CurrentSessionId;

        if (!_isAllSessions && _selectedSessionId is Guid sid && _sessions.All(s => s.Id != sid) && _sessions.Count > 0)
        {
            _selectedSessionId = _sessions[0].Id;
            _selectedKey = _selectedSessionId.Value.ToString();
        }

        _isCurrentSession = !_isAllSessions && _selectedSessionId == Sessions.CurrentSessionId;
        _rankings = Sessions.GetRankings(_selectedSessionId);
        _recentGames = Sessions.GetRecentGames(_selectedSessionId, _isAllSessions ? 40 : 20);
        _stats = Sessions.GetSessionStats(_selectedSessionId);
        _attendeeIds = _selectedSessionId is Guid sessionId
            ? Sessions.GetAttendeeIds(sessionId)
            : new HashSet<Guid>();
        _allPlayers = Sessions.GetAllPlayers();
    }

    private void StartEditName(Guid sessionId)
    {
        var session = _sessions.FirstOrDefault(s => s.Id == sessionId);
        _sessionNameEdit = session is null || string.IsNullOrWhiteSpace(session.Name)
            ? (session?.Date.ToString("ddd d MMM yyyy") ?? "")
            : session.Name;
        _editingSessionId = sessionId;
    }

    private void CancelEditName() => _editingSessionId = null;

    private void SaveSessionName()
    {
        if (_editingSessionId is not Guid sessionId) return;
        Sessions.UpdateSessionName(sessionId, _sessionNameEdit);
        _editingSessionId = null;
        LoadData();
    }

    private void StartEditPlayer(Guid playerId, string name)
    {
        _editingPlayerId = playerId;
        _playerNameEdit = name;
    }

    private void CancelEditPlayer() => _editingPlayerId = null;

    private void SavePlayerName()
    {
        if (_editingPlayerId is not Guid playerId) return;
        if (!Allocation.RenamePlayer(playerId, _playerNameEdit)) return;

        _editingPlayerId = null;
        LoadData();
    }

    private async Task TogglePaid(Guid playerId, bool hasPaid)
    {
        if (_selectedSessionId is not Guid sessionId) return;
        Sessions.SetHasPaid(sessionId, playerId, hasPaid);

        // When the active filter will remove this row, wait until the checkbox
        // change event finishes so the next row doesn't inherit the click.
        if (_attendanceFilter is "paid" or "unpaid")
            await Task.Yield();

        LoadData();
    }

    private void ToggleAttendance(Guid playerId, bool present)
    {
        if (_selectedSessionId is not Guid sessionId) return;
        Sessions.ToggleAttendance(sessionId, playerId, present);
        if (present && _isCurrentSession)
            Allocation.CheckInPlayer(playerId);
        LoadData();
    }

    private void SelectAllAttendance()
    {
        if (_selectedSessionId is not Guid sessionId) return;
        foreach (var player in _allPlayers)
        {
            if (_attendeeIds.Contains(player.Id)) continue;
            Sessions.ToggleAttendance(sessionId, player.Id, true);
            Allocation.CheckInPlayer(player.Id);
        }
        LoadData();
    }

    private void ClearAllAttendance()
    {
        if (_selectedSessionId is not Guid sessionId) return;
        foreach (var playerId in _attendeeIds.ToList())
            Sessions.ToggleAttendance(sessionId, playerId, false);
        LoadData();
    }

    private void OpenSessionManager()
    {
        _newSessionName = DateOnly.FromDateTime(DateTime.UtcNow).ToString("ddd d MMM yyyy");
        _editingSessionId = null;
        _showSessionManager = true;
    }

    private void CloseSessionManager()
    {
        _showSessionManager = false;
        _editingSessionId = null;
    }

    private void ConfirmCreateSession()
    {
        var sessionId = Sessions.CreateNewSession(_newSessionName);
        _selectedKey = sessionId.ToString();
        _newSessionName = "";
        LoadData();
    }

    private void AskDeleteSession(Guid sessionId)
    {
        _sessionPendingDeleteId = sessionId;
        _confirmDeleteSession = true;
    }

    private void CancelDeleteSession()
    {
        _confirmDeleteSession = false;
        _sessionPendingDeleteId = null;
    }

    private void ConfirmDeleteSession()
    {
        if (_sessionPendingDeleteId is not Guid sessionId) return;

        var deletedSelectedSession = _selectedSessionId == sessionId;
        var currentSessionId = Sessions.DeleteSession(sessionId);
        _confirmDeleteSession = false;
        _sessionPendingDeleteId = null;
        _editingSessionId = null;
        if (deletedSelectedSession)
            _selectedKey = currentSessionId.ToString();
        LoadData();
    }

    private void Refresh() => InvokeAsync(() =>
    {
        LoadData();
        StateHasChanged();
    });

    private static (string Winners, string Losers, string Score) FormatGameResult(GameSummaryRow game)
    {
        var aScore = game.TeamAScore?.ToString() ?? "—";
        var bScore = game.TeamBScore?.ToString() ?? "—";

        return game.WinnerSide switch
        {
            "TeamA" => (game.TeamANames, game.TeamBNames, $"{aScore} : {bScore}"),
            "TeamB" => (game.TeamBNames, game.TeamANames, $"{bScore} : {aScore}"),
            _ => (game.TeamANames, game.TeamBNames, $"{aScore} : {bScore}")
        };
    }

    public void Dispose()
    {
        Sessions.OnChange -= Refresh;
        Sessions.ModeChanged -= OnModeChanged;
    }
}
